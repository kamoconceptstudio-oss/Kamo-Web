# Copiar este archivo a ".env.local" (ignorado por git) y sustituir los
# valores por los reales cuando esten disponibles. Sin RESEND_API_KEY el
# formulario de contacto sigue funcionando (build y web no se rompen): la
# ruta /api/contact responde con un error controlado "servicio no
# configurado todavia" en vez de enviar el email.

# API key de Resend (https://resend.com) para el envio de emails del
# formulario de contacto. Crear cuenta, generar la key y pegarla aqui.
RESEND_API_KEY=re_placeholder_replace_me

# Direccion donde deben llegar las consultas del formulario de contacto.
CONTACT_EMAIL_TO=contacto@kamoconcept.com

# Remitente verificado en Resend. Mientras el dominio no este verificado en
# Resend, usar su remitente de pruebas (onboarding@resend.dev), que solo
# entrega correctamente al email de la propia cuenta de Resend. Sustituir
# por un remitente en el dominio real (p. ej. "Kamo Concept
# <contacto@kamoconcept.com>") en cuanto el dominio este verificado.
CONTACT_EMAIL_FROM=Kamo Concept <onboarding@resend.dev>

# Codigo de verificacion de Google Search Console (metodo "etiqueta HTML").
# Buscar en Search Console > Configuracion > Verificacion de la propiedad,
# es el valor del atributo content de la meta tag que ofrece Google.
GOOGLE_SITE_VERIFICATION=

# ID de metricas de Google Analytics 4 (formato G-XXXXXXXXXX). Publico a
# proposito (prefijo NEXT_PUBLIC_) porque el script de gtag se ejecuta en
# el navegador. Solo se carga si el usuario acepta el banner de cookies
# (ver components/analytics/CookieConsent.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
